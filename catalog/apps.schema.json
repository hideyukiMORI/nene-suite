{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nene-suite.dev/catalog/apps.schema.json",
  "title": "NeNe Suite App Catalog",
  "type": "object",
  "required": ["version", "apps"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "status", "requires", "provides"],
        "properties": {
          "id": { "type": "string", "pattern": "^nene-[a-z0-9-]+$" },
          "name": { "type": "string" },
          "repository": { "type": ["string", "null"] },
          "path": { "type": "string" },
          "status": { "enum": ["planned", "installable", "deprecated"] },
          "requires": { "type": "array", "items": { "type": "string" } },
          "provides": { "type": "array", "items": { "type": "string" } },
          "install_entry": { "type": "string" },
          "database": {
            "type": "object",
            "required": ["env_prefix"],
            "properties": {
              "env_prefix": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
