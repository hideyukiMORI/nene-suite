# NeNe Suite — example environment (non-secret template)
# Suite installer generates per-app .env files from these values.
# See docs/explanation/suite-environment-contract.md

NENE_SUITE_MODE=1
NENE_SUITE_ID=01J000000000000000000000000
NENE_SUITE_BASE_URL=https://example.com/
NENE_SUITE_APEX_URL=https://example.com/
NENE_SUITE_ISSUER_URL=https://example.com/api/auth
NENE_SUITE_JWT_SECRET=
NENE_SUITE_ORG_EXTERNAL_ID=01J000000000000000000000001
NENE_SUITE_ORG_NAME="Example Organization"
NENE_SUITE_INSTALLED_APPS=nene-invoice,nene-clear

# Suite control DB — audit trail + install metadata (Phase 1+; not sibling app data)
# NENE_SUITE_CONTROL_DATABASE_URL=mysql://nene_suite:@db:3306/nene_suite

# Sibling public bases (installed subset only)
NENE_SUITE_APP_NENE_INVOICE_URL=https://example.com/nene-invoice/
NENE_SUITE_APP_NENE_CLEAR_URL=https://example.com/nene-clear/

# Each app still has its own DB_* block — written by installer, not duplicated here.
