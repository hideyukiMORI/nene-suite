# NeNe Suite — example environment (non-secret template)
# Suite installer generates per-app .env files from these values.
# See docs/explanation/suite-environment-contract.md

NENE_SUITE_MODE=1
NENE_SUITE_ID=01J000000000000000000000000
NENE_SUITE_BASE_URL=https://example.com/
NENE_SUITE_APEX_URL=https://example.com/
NENE_SUITE_ISSUER_URL=https://example.com/api/auth
NENE_SUITE_JWT_SECRET=
NENE_SUITE_ORG_EXTERNAL_ID=01J000000000000000000000001
NENE_SUITE_ORG_NAME="Example Organization"
NENE_SUITE_INSTALLED_APPS=nene-invoice,nene-clear

# Suite control DB — audit trail + install metadata (Phase 1+; not sibling app data)
# NENE_SUITE_CONTROL_DATABASE_URL=mysql://nene_suite:@db:3306/nene_suite

# Provisioning write side (Tier B installer)
# Path where WriteEnvConfigUseCase writes the generated .env file
# NENE_SUITE_ENV_FILE_PATH=/srv/suite/.env.suite
# Privileged DB connection used to CREATE DATABASE for each installed app (not the control DB)
# NENE_SUITE_PROVISION_DB_HOST=db
# NENE_SUITE_PROVISION_DB_PORT=3306
# NENE_SUITE_PROVISION_DB_USER=root
# NENE_SUITE_PROVISION_DB_PASSWORD=

# Sibling public bases (installed subset only)
NENE_SUITE_APP_NENE_INVOICE_URL=https://example.com/nene-invoice/
NENE_SUITE_APP_NENE_CLEAR_URL=https://example.com/nene-clear/

# Each app still has its own DB_* block — written by installer, not duplicated here.

# Tier B installer CLI (docker compose run --rm suite php installer/install.php)
# NENE_SUITE_DISCLAIMER_ACCEPTED=1
# NENE_SUITE_DISCLAIMER_VERSION=2026-05-31
# NENE_SUITE_APEX_OPERATOR_EMAIL=admin@example.com
# NENE_SUITE_APEX_OPERATOR_PASSWORD=
# NENE_SUITE_APEX_OPERATOR_NAME="Suite Admin"

# Docker Compose (docker-compose.yml)
# Local dev ports are fixed in CLAUDE.md to avoid host collisions.
# NENE_SUITE_CONTROL_DB_PASSWORD=
# SUITE_HTTP_PORT=8800   # apex shell  — fixed per CLAUDE.md portfolio registry
# SUITE_DB_PORT=3389     # MySQL local — fixed per CLAUDE.md portfolio registry
