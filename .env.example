APP_ENV=local
APP_DEBUG=false
APP_NAME=NeNe Suite
PROBLEM_DETAILS_BASE_URL=https://nene-suite.dev/problems/

# --- Suite control database (host / PHPUnit default: SQLite) ---
# The control database is named `nene_suite` and holds only orchestration
# metadata (install_sessions, suite_audit_events) — never sibling app data.
# The installer will populate these from NENE_SUITE_CONTROL_DATABASE_URL; until
# the installer ADR lands, configure the framework DB_* values directly.
DATABASE_URL=
DB_ENV=local
DB_ADAPTER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=var/nene_suite.sqlite
DB_USER=nene_suite
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Docker Compose overrides (copy to .env and uncomment for local stack) ---
# DB_ADAPTER=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=nene_suite
# DB_USER=nene_suite
# DB_PASSWORD=nene_suite

# --- Suite mode (written per docs/explanation/suite-environment-contract.md) ---
# NENE_SUITE_MODE=1
# NENE_SUITE_ID=
# NENE_SUITE_ORG_EXTERNAL_ID=
# NENE_SUITE_JWT_SECRET=          # required to serve; unset = fail-closed at boot (apex refuses to start)
# NENE_SUITE_ALLOW_DEV_SECRET=1   # dev-only opt-in; permits the built-in dev secret when JWT_SECRET is unset
# NENE_SUITE_CONTROL_DATABASE_URL=
